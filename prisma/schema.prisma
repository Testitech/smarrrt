// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum EmailKind {
  WELCOME
}

enum EmailStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum PofAmountScope {
  TOTAL_ESTIMATE
  LIVING_COSTS_ONLY
  VARIABLE_REQUIREMENT
}

// ─────────────────────────────────────────
// AUTH MODELS (NextAuth required)
// ─────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  name            String?
  email           String?   @unique
  emailVerified   DateTime?
  image           String?
  profileImageUrl String?
  username        String?   @unique
  role            UserRole  @default(USER)
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // relations

  accounts        Account[]
  sessions        Session[]
  timelines       UserTimeline[]
  emailDeliveries EmailDelivery[]
  auditLogs       AdminAuditLog[] @relation("AuditActor")

  @@index([role, isActive])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────
// CORE ENTITIES
// ─────────────────────────────────────────

model Country {
  id           String  @id
  name         String  @unique
  isoCode      String  @unique
  currencyCode String
  flagEmoji    String
  isActive     Boolean @default(true)

  // relations

  pofRules    PofRule[]
  studyIntake StudyIntake[]
  fxRates     FxRate         @relation(fields: [currencyCode], references: [currencyCode])
  timelines   UserTimeline[]
}

model VisaPurpose {
  id          String  @id
  name        String  @unique
  slug        String  @unique // eg "study", "work", "tourism"
  icon        String
  description String?
  isActive    Boolean @default(true)

  // Relations
  pofRules  PofRule[]
  timelines UserTimeline[]
}

// ─────────────────────────────────────────
// THE STRATEGY ENGINE
// ─────────────────────────────────────────

model PofRule {
  id        String @id @default(cuid())
  countryId String
  purposeId String

  // Buffer offsets in months
  safeBufferMonths    Int // e.g. 6 for Canada Study
  cautionBufferMonths Int // e.g. 3 for Canada Study
  riskyBufferMonths   Int // e.g. 1 for Canada Study

  // Minimum POF amount in foreign currency
  minAmountForeign Float

  // Does embassy scrutinise lump sums?
  requiresHistory Boolean @default(false)

  // Nigerian-specific analysis text
  // Templated: supports {{parallelRate}}, {{safeDate}}, {{nairaTarget}}

  analysisText     String @db.Text
  nigerianSpecific String @db.Text

  // Evidence coverage is distinct from a statutory holding period and from
  // the maximum permitted age of a document.
  statementMonths    Int? // transaction-history coverage in months
  documentMaxAgeDays Int?

  // Operational controls and provenance. Rules should never be presented as
  // current without a source and a recent review date.
  isActive          Boolean        @default(true)
  ruleVersion       String         @default("2026.1")
  holdingPeriodDays Int?
  amountScope       PofAmountScope @default(VARIABLE_REQUIREMENT)
  sourceUrl         String?
  sourceCheckedAt   DateTime?
  effectiveFrom     DateTime?
  effectiveTo       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  country Country     @relation(fields: [countryId], references: [id])
  purpose VisaPurpose @relation(fields: [purposeId], references: [id])

  @@unique([countryId, purposeId])
}

// Study-specific intake months per country

model StudyIntake {
  id           String  @id @default(cuid())
  countryId    String
  intakeMonth  Int // 1 = Jan
  intakeName   String // e.g. "September Main Intake"
  isMainIntake Boolean @default(false)

  country Country @relation(fields: [countryId], references: [id])

  @@unique([countryId, intakeMonth])
}

// ─────────────────────────────────────────
// FX RATES (Nigerian Context)
// ─────────────────────────────────────────

model FxRate {
  currencyCode String   @id // e.g. "GBP"
  cbnRate      Float // Official CBN rate
  parallelRate Float // Black market / parallel rate
  source       String   @default("seed-reference")
  isIndicative Boolean  @default(true)
  lastUpdated  DateTime @updatedAt

  // Relations
  countries Country[]
}

// ─────────────────────────────────────────
// USER SAVED TIMELINES
// ─────────────────────────────────────────

model UserTimeline {
  id        String @id @default(cuid())
  userId    String
  countryId String
  purposeId String
  slug      String @unique // eg "my-study-uk-plan"

  // User inputs
  intakeDate     DateTime
  intakeKey      String // UTC YYYY-MM, used for deterministic idempotency
  currentBalance Float // In Naira
  targetAmount   Float? // Null when the official requirement depends on applicant circumstances
  monthlyDeposit Float? // Null when no responsible fixed funding pace can be calculated

  // Calculated timeline results
  safeStartDate    DateTime
  cautionStartDate DateTime
  riskyStartDate   DateTime

  // Status at time of save
  currentStatus String // "safe" | "caution" | "risky"
  calculatedAt  DateTime @default(now())
  ruleVersion   String?
  fxRateUsed    Float?
  amountScope   PofAmountScope?
  ruleSourceUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  country Country     @relation(fields: [countryId], references: [id])
  purpose VisaPurpose @relation(fields: [purposeId], references: [id])

  @@unique([userId, countryId, purposeId, intakeKey])
  @@index([userId, updatedAt])
  @@index([countryId, purposeId])
}

model EmailDelivery {
  id                String      @id @default(cuid())
  eventKey          String      @unique
  kind              EmailKind
  status            EmailStatus @default(PENDING)
  userId            String
  recipient         String
  payload           Json
  attempts          Int         @default(0)
  nextAttemptAt     DateTime    @default(now())
  lockedAt          DateTime?
  lastAttemptAt     DateTime?
  sentAt            DateTime?
  providerMessageId String?     @unique
  lastError         String?     @db.Text
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([userId, createdAt])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

model CmsItem {
  collection String
  itemId     String
  data       Json
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@id([collection, itemId])
  @@index([collection, order])
}

