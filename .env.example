
DATABASE_URL=
# DATABASE_URL above is already direct.
DIRECT_URL=
DATABASE_POOL_SIZE="5"

# Auth.js
AUTH_SECRET=
AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Absolute origin used in transactional email links
APP_URL=

# Resend (EMAIL_FROM must use a verified domain in production)
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Comma-separated, case-insensitive bootstrap allowlist
ADMIN_EMAILS=

# Protects /api/cron/* with Authorization: Bearer <secret>
CRON_SECRET=

# Keep disabled until a real, reviewed FX provider replaces placeholder data
ENABLE_PLACEHOLDER_FX_SYNC=
